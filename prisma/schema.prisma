generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  CONSUMER
  BUSINESS
  ADMIN
}

enum BusinessCategory {
  FITNESS
  YOGA
  SALON
  BARBERSHOP
  SPA
  MASSAGE
  DENTAL
  MEDICAL
  PHYSIOTHERAPY
  MENTAL_HEALTH
  RESTAURANT
  OTHER
}

enum CalendarProvider {
  FRESHA
  MINDBODY
  JANEAPP
  CALENDLY
  MANUAL
}

enum CancellationStatus {
  AVAILABLE
  BOOKED
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum NotificationType {
  NEW_CANCELLATION
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  REMINDER
  PROMO
}

// ─── Auth Models (existing) ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Extended fields
  role         UserRole? // No default, so we can detect new users
  phone        String?
  avatarUrl    String?
  lat          Float?
  lng          Float?
  searchRadius Int      @default(10) // in km

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  // Auth relations
  accounts Account[]
  sessions Session[]

  // Domain relations
  business      Business?
  preferences   UserPreference[]
  bookings      Booking[]
  watchlist     Watchlist[]
  notifications Notification[]
  reviews       Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User Preferences ────────────────────────────────────

model UserPreference {
  id       String           @id @default(cuid())
  userId   String
  category BusinessCategory
  enabled  Boolean          @default(true)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// ─── Business ────────────────────────────────────────────

model Business {
  id          String           @id @default(cuid())
  ownerId     String           @unique
  name        String
  slug        String           @unique
  description String?          @db.Text
  email       String?          // Contact email for notifications
  logoUrl     String?
  coverUrl    String?
  category    BusinessCategory
  address     String
  city        String
  state       String
  zip         String
  lat         Float
  lng         Float
  phone       String?
  website     String?

  calendarProvider  CalendarProvider @default(MANUAL)
  calendarSyncToken String?

  stripeAccountId String?
  platformFeeRate Float    @default(0.10) // 10% default

  avgRating Float   @default(0)
  verified  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services      Service[]
  cancellations Cancellation[]
  bookings      Booking[]
  reviews       Review[]
  watchers      Watchlist[]

  @@index([lat, lng])
  @@index([category])
}

model Service {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  category        BusinessCategory
  durationMinutes Int
  originalPrice   Decimal          @db.Decimal(10, 2)
  description     String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cancellations Cancellation[]

  @@index([businessId])
}

// ─── Cancellations (core marketplace entity) ─────────────

model Cancellation {
  id                String             @id @default(cuid())
  businessId        String
  serviceId         String
  originalStartTime DateTime
  originalEndTime   DateTime
  discountPercent   Int
  discountedPrice   Decimal            @db.Decimal(10, 2)
  status            CancellationStatus @default(AVAILABLE)

  // Discount bounds (business-configurable)
  minDiscount Int @default(10)
  maxDiscount Int @default(50)

  listedAt  DateTime  @default(now())
  expiresAt DateTime  // = originalStartTime
  bookedAt  DateTime?

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  booking  Booking?

  @@index([status, expiresAt])
  @@index([businessId])
}

// ─── Bookings & Payments ─────────────────────────────────

model Booking {
  id             String        @id @default(cuid())
  userId         String
  cancellationId String        @unique
  businessId     String
  status         BookingStatus @default(CONFIRMED)
  paidAmount     Decimal       @db.Decimal(10, 2)
  platformFee    Decimal       @db.Decimal(10, 2)

  stripePaymentIntentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cancellation Cancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review       Review?

  @@index([userId])
  @@index([businessId])
}

model Review {
  id         String  @id @default(cuid())
  bookingId  String  @unique
  userId     String
  businessId String
  rating     Int // 1-5
  comment    String? @db.Text

  createdAt DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── Watchlist ───────────────────────────────────────────

model Watchlist {
  id         String @id @default(cuid())
  userId     String
  businessId String

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

// ─── Notifications ───────────────────────────────────────

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType
  title  String
  body   String           @db.Text
  data   Json?
  read   Boolean          @default(false)

  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
